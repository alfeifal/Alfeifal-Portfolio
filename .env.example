# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_os
# Separate database used by `pnpm test` (integration tests). Optional.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_os_test

# ---- Security ----
# Random 32+ byte secret used to sign/derive session and CSRF material. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
# Allow creating additional accounts after the first one. The first account can always be created from /setup.
ALLOW_SIGNUP=false
# Comma-separated list of origins allowed to send state-changing requests (defaults to the request host).
ALLOWED_ORIGINS=

# ---- AI (server-side only, never shipped to the client) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Market data providers (optional, all pluggable) ----
# Free key from https://finnhub.io — used for real-time quotes when present. Without it, Stooq / Yahoo (delayed, key-less) are used.
FINNHUB_API_KEY=
# Comma separated extra RSS feeds for market news (headline|url|category). Built-in feeds are already configured.
EXTRA_NEWS_FEEDS=

# ---- App ----
APP_NAME="Personal OS"
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_CURRENCY=EUR

# Database driver: pg (default, TCP 5432) | neon (Neon serverless over WebSocket/443)
DATABASE_DRIVER=pg
